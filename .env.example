# S&P Global & CRISIL Hackathon 2026 - Module B: Stress Testing
# Environment Configuration Template

# Server Port
PORT=8080
SERVER_PORT=8080

# NLP Sidecar Configuration
NLP_SERVICE_URL=http://localhost:8000
NLP_SERVICE_TIMEOUT_MS=3000

# External Ingestion APIs (optional; offline fallbacks are bundled)
NEWSAPI_KEY=
GDELT_ENABLED=true

# Database Configuration (defaults to in-memory H2)
SPRING_PROFILES_ACTIVE=dev

# Trigger Service Configuration
STRESS_IMPACT_THRESHOLD=7
STRESS_CONFIDENCE_THRESHOLD=0.5
STRESS_DEBOUNCE_MINUTES=30
